# Copy to .env and fill in real values. Never commit .env.
# 注意：`#` 注释必须独占一行，不要写在值后面（本项目使用无依赖的简易解析器，
# 密码里允许出现 `#`，因此不做过多的行内注释剥离）。

# ---- ClickHouse ----
CH_HOST=192.168.0.193
CH_PORT=8123
CH_DATABASE=shop

# 查询账号（只读）
CH_USER=readonly
CH_PASSWORD=

# 灌数账号（需要 CREATE / INSERT / TRUNCATE），缺省回落到 CH_USER
CH_WRITE_USER=default
CH_WRITE_PASSWORD=
CH_TIMEOUT_S=30
CH_MAX_ROWS=10000

# ---- LLM ----
# LLM_PROVIDER: ollama | deepseek | openai | anthropic
LLM_PROVIDER=ollama
# Text2SQL 建议用 coder 系列；两种模型可各自跑一遍做对照
LLM_MODEL=qwen2.5-coder:7b
OLLAMA_HOST=http://192.168.0.228:11434
# Ollama 上下文窗口；8k 在长工具结果下可能截断，显存允许时设 16384
LLM_NUM_CTX=8192
# CPU 推理下单次请求可能很慢：超时放宽，同时限制生成长度
LLM_TIMEOUT_S=600
LLM_MAX_PREDICT=512
# 单轮最多工具调用次数（含 SQL 重试）
AGENT_MAX_ITERATIONS=8

# DeepSeek（OpenAI 兼容端点）。切换时把上面改成：
#   LLM_PROVIDER=deepseek
#   LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---- Evaluation ----
# 留空则使用 <repo>/reports
EVAL_REPORTS_DIR=

# Stage 3 memory (default demo; set chroma_local for local retrieval)
MEMORY_BACKEND=demo
MEMORY_PATH=analytics_agent/memory/data/chroma
MEMORY_COLLECTION=analytics_memory_v1
# 一个 collection 只能绑定一个 embedding 模型；换模型必须新建 collection
# 并重新导入全部种子，否则旧向量与新查询向量不兼容。
MEMORY_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
