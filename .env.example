# Copy to .env and fill in real values. Never commit .env.

# ---- ClickHouse ----
CH_HOST=192.168.0.193
CH_PORT=8123
CH_DATABASE=shop
# 查询账号（只读）
CH_USER=readonly
CH_PASSWORD=
# 灌数账号（需要 CREATE / INSERT / TRUNCATE），缺省回落到 CH_USER
CH_WRITE_USER=default
CH_WRITE_PASSWORD=
CH_TIMEOUT_S=30
CH_MAX_ROWS=10000

# ---- LLM ----
LLM_PROVIDER=ollama          # ollama | openai | anthropic
LLM_MODEL=qwen2.5:7b
OLLAMA_HOST=http://192.168.0.228:11434

# ---- Evaluation ----
EVAL_REPORTS_DIR=
