# Copy to .env and fill in real values. Never commit .env.
# 注意：`#` 注释必须独占一行，不要写在值后面（本项目使用无依赖的简易解析器，
# 密码里允许出现 `#`，因此不做过多的行内注释剥离）。

# ---- ClickHouse ----
CH_HOST=192.168.0.193
CH_PORT=8123
CH_DATABASE=shop

# 查询账号（只读）
CH_USER=readonly
CH_PASSWORD=

# 灌数账号（需要 CREATE / INSERT / TRUNCATE），缺省回落到 CH_USER
CH_WRITE_USER=default
CH_WRITE_PASSWORD=
CH_TIMEOUT_S=30
CH_MAX_ROWS=10000

# ---- LLM ----
# LLM_PROVIDER: ollama | openai | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
OLLAMA_HOST=http://192.168.0.228:11434

# ---- Evaluation ----
# 留空则使用 <repo>/reports
EVAL_REPORTS_DIR=
