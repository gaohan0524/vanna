  "cards": [
    {
      "dot": "cyan",
      "title": "产品做什么",
      "items": [
        "用户用自然语言提问，结果以表格、图表、文本卡片流式返回",
        "所有输出都是 UiComponent，同一份数据既能渲染富组件也能降级为纯文本"
      ]
    },
    {
      "dot": "rose",
      "title": "编排与权限",
      "items": [
        "Agent 先解析身份，再按用户分组过滤可见工具",
        "工具循环上限 max_tool_iterations，默认 10 轮",
        "组件由服务端逐块 yield，服务端不保存组件树"
      ]
    },
    {
      "dot": "emerald",
      "title": "可替换后端",
      "items": [
        "LlmService、SqlRunner、AgentMemory、FileSystem 均为抽象基类",
        "integrations 下每个供应商一个目录，local 与 mock 提供无依赖实现"
      ]
    }
  ]
